{
    "name": "silverstripe/recipe-serverless",
    "type": "silverstripe-recipe",
    "description": "SilverStripe framework-only core recipe",
    "homepage": "http://silverstripe.org",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/assets": "^3.0",
        "silverstripe/config": "^3.0",
        "silverstripe/framework": "^6.0",
        "silverstripe/mimevalidator": "^4.0",
        "bref/bref": "^2.0",
        "composer-plugin-api": "^2",
        "silverstripe/sqlite3": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3"
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/",
            "App\\Tests\\": "app/tests/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "extra": {
        "project-dependencies-installed": {
            "composer-plugin-api": "^2",
            "php": "^8.1"
        }
    },
    "provide": {
        "silverstripe/recipe-plugin": "2.0.0"
    }
}
